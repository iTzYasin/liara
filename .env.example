# Google Gemini API
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
GEMINI_EVAL_JUDGE_MODEL=gemini-flash-latest
# Optional smoke subset; omit to evaluate all 120 scenarios.
GEMINI_EVAL_LIMIT=

# AvalAI OpenAI-compatible API
AVALAI_API_KEY=
AVALAI_BASE_URL=
AVALAI_MODEL=deepseek-v4-flash

# App behavior
DEMO_MODE=false
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_HOUR=60
CHAT_MESSAGE_LIMIT=20
CHAT_MESSAGE_WINDOW_MINUTES=30
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_IDENTITY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_STORE_TIMEOUT_MS=1000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
ALLOWED_ORIGINS=

# Optional Meilisearch. Without MEILI_URL the committed local index is used.
MEILI_URL=
MEILI_API_KEY=
MEILI_INDEX_UID=liara_docs
MEILI_SEARCH_TIMEOUT_MS=2500

# Optional docs sync override
LIARA_DOCS_REPOSITORY=https://github.com/liara-cloud/docs.git
